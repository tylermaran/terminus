// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String
  color     String   @default("#00ff88")
  createdAt DateTime @default(now())

  gameStates   GameState[]
  chatMessages ChatMessage[]

  @@unique([username])
}

model GameState {
  id                           String   @id @default(uuid())
  userId                       String
  metal                        Float    @default(100)
  metalFactoryLevel            Int      @default(1)
  metalFactoryUpgradeStartTime BigInt?
  metalFactoryUpgradeDuration  BigInt   @default(0)
  lastUpdate                   BigInt
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  room      String   @default("GENERAL")
  userId    String
  username  String
  color     String
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([room, createdAt])
  @@index([userId])
}
